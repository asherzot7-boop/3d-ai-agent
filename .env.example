# Скопируйте в .env и заполните. Файл .env не попадает в git.

# PIN руководителя (видит всё, меняет цены и отметки документов)
OWNER_PIN=
# Общий PIN для сотрудников, у кого нет личного. Личные PIN: npm run pin -- "Имя" 1234
STAFF_PIN=
# Длинная случайная строка, чтобы вход не сбрасывался после перезапуска
SESSION_SECRET=

# Ключ Claude API (console.anthropic.com). Без него сайт и приложение работают, но ИИ выключен.
ANTHROPIC_API_KEY=
# Модель и глубина ответа (по умолчанию claude-opus-5-5, medium). Дешевле: AI_MODEL=claude-haiku-5-5
AI_MODEL=
AI_EFFORT=

# Telegram-бот Малохат (токен от @BotFather). Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=

# Лимиты запросов к ИИ
AI_PER_HOUR=
MALOHAT_PER_HOUR=30

PORT=8080
# Где хранится база (db.json) и PIN-коды
DATA_DIR=storage
# 1 — если сервер стоит за nginx/Caddy/Cloudflare (для правильных IP в лимитах)
TRUST_PROXY=
