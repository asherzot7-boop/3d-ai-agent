# Nusxa oling: cp .env.example .env
# .env fayli git'ga tushmaydi.

# ── BEPUL rejim (standart, kalit shart emas) ──
# Ovoz: edge-tts (pip install edge-tts). O'zbekcha: uz-UZ-MadinaNeural (ayol), uz-UZ-SardorNeural (erkak)
EDGE_VOICE=uz-UZ-MadinaNeural
EDGE_RATE=+0%
# Rasm: Pollinations Flux. Token ixtiyoriy: bepul ro'yxatdan o'tsangiz, navbat tezroq yuradi (auth.pollinations.ai)
POLLINATIONS_MODEL=flux
POLLINATIONS_TOKEN=

# ── PULLIK rejim (--provider paid) ──

# Video generatsiya — https://dev.runwayml.com
RUNWAY_API_KEY=
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_MODEL=gen4_turbo

# Ovoz — https://elevenlabs.io (Profile → API Keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
